{
    "name": "hylimo",
    "version": "3.0.0-alpha.1",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hylimo/hylimo.git"
    },
    "workspaces": [
        "packages/*",
        "website"
    ],
    "scripts": {
        "build": "npm run build:wasm-libs && npm run build:packages",
        "build:wasm-libs": "npm run build -w packages/wasm-libs",
        "build:packages": "tsc -b tsconfig.build.json",
        "watch": "tsc -b tsconfig.build.json --watch",
        "dev": "npm run -w ./website dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "oxlint --type-aware --fix",
        "lint:check": "oxlint --type-aware"
    },
    "devDependencies": {
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2"
    },
    "prettier": {
        "tabWidth": 4,
        "trailingComma": "none",
        "printWidth": 120,
        "overrides": [
            {
                "files": [
                    "*.md",
                    "*.yml",
                    "*.yaml"
                ],
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
